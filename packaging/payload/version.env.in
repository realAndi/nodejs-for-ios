# Which Node.js this package installs, and the checksum the postinst holds it
# to. Generated by tools/build-deb.sh from nodejs.org's SHASUMS256.txt at build
# time, so the device verifies against what this build saw rather than against
# whatever it is served later.
NODE_VERSION=@NODE_VERSION@
NODE_TARBALL=@NODE_TARBALL@
NODE_TARBALL_SHA256=@NODE_TARBALL_SHA256@
NODE_URL=@NODE_DIST@/v@NODE_VERSION@/@NODE_TARBALL@
